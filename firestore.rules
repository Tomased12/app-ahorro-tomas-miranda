rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permite lectura y escritura de transacciones y categorías para Tomas y Miranda
    // En producción con Firebase Auth puedes restringir por request.auth.uid != null
    match /transactions/{transactionId} {
      allow read, write: if true;
    }
    
    match /categories/{categoryId} {
      allow read, write: if true;
    }
  }
}
